<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.rahim2797.phputils</id>
    <name>PHP Utilities</name>
    <vendor>rahim2797</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.jetbrains.php</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor
                language="PHP"
                implementationClass="com.github.rahim2797.phputils.properties.PropertiesPhpDocCompletionContributor"/>
        <additionalLibraryRootsProvider implementation="com.github.rahim2797.phputils.properties.PropertiesStubLibraryRootsProvider"/>
        <psi.referenceContributor
                language="PHP"
                implementation="com.github.rahim2797.phputils.properties.PropertiesKeyReferenceContributor"/>
        <lang.inspectionSuppressor
                language="PHP"
                implementationClass="com.github.rahim2797.phputils.properties.PropertiesInspectionSuppressor"/>
        <localInspection
                language="PHP"
                shortName="PropertiesTypeContradiction"
                displayName="Properties magic type contradiction"
                groupName="PHP Utilities"
                enabledByDefault="true"
                implementationClass="com.github.rahim2797.phputils.properties.PropertiesTypeContradictionInspection"/>
        <lang.documentationProvider
                language="PHP"
                implementationClass="com.github.rahim2797.phputils.properties.PropertiesDocumentationProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.jetbrains">
        <php.typeProvider4 implementation="com.github.rahim2797.phputils.properties.PropertiesArrayAccessTypeProvider"/>
    </extensions>
</idea-plugin>
