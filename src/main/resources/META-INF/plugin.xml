<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.rahim2797.phputils</id>
    <name>PHP Utilities</name>
    <vendor>rahim2797</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.jetbrains.php</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor
                language="PHP"
                implementationClass="com.github.rahim2797.phputils.magictypes.ide.MagicTypePhpDocCompletionContributor"/>
        <additionalLibraryRootsProvider implementation="com.github.rahim2797.phputils.properties.PropertiesStubLibraryRootsProvider"/>
        <psi.referenceContributor
                language="PHP"
                implementation="com.github.rahim2797.phputils.magictypes.ide.MagicTypeKeyReferenceContributor"/>
        <lang.inspectionSuppressor
                language="PHP"
                implementationClass="com.github.rahim2797.phputils.magictypes.ide.MagicTypeInspectionSuppressor"/>
        <localInspection
                language="PHP"
                shortName="MagicTypeContradiction"
                displayName="Magic type contradiction"
                groupName="PHP Utilities"
                enabledByDefault="true"
                implementationClass="com.github.rahim2797.phputils.magictypes.ide.MagicTypeContradictionInspection"/>
        <lang.documentationProvider
                language="PHP"
                implementationClass="com.github.rahim2797.phputils.magictypes.ide.MagicTypeDocumentationProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.jetbrains">
        <php.typeProvider4 implementation="com.github.rahim2797.phputils.magictypes.ide.MagicTypeArrayAccessTypeProvider"/>
    </extensions>
</idea-plugin>
